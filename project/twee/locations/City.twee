:: Park_JoggerMaleThought [_back_]
<section><aside id="sidebar"></aside><article><%=window.story.render("CenterDialogs") %>
<% var ft="ftHetero",ftinc=0,influence=-5,arousal=10;window.gm.player.Stats.increment("arousal",arousal);window.gm.player.Stats.increment("influence",influence);
if(window.gm.player.Stats.get(ft).value<=10) ftinc=1,window.gm.player.Stats.increment(ft,ftinc);
if(window.gm.player.Stats.get("corruption").value<=10) ftinc=1,window.gm.player.Stats.increment("corruption",ftinc);
window.gm.refreshSidePanel(); %>
<p>TODO  Those muscles... would be nice to get embraced by someone like that...
<p><%=window.gm.printStatChange('arousal',arousal)+window.gm.printStatChange('influence',influence)%><br>
<p><%=window.gm.printStatChange(ft,ftinc)+window.gm.printStatChange("corruption",ftinc)%></p>
<br>[[Next|<%=window.gm.player.location%>]]
</p> 
</article><article id="LogPanel"></article></section>


