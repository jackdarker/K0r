:: Central_Slap [_back_]
<section><aside id="sidebar"></aside><article><%=window.story.render("CenterDialogs") %>
<img src='assets/img/Window1.jpg' alt="Poster" width="90%">
<p>An advertising poster attracts your attention. </p> 
<div id='select1' >   </div>
    <div id='choice1a' hidden> Its about a new drink with extra protein. <br>
    <a0 onclick='window.story.show("_back_");'>Pass on</a>
    </div>
    <div id='choice1b' hidden> Seems to be just about some people at work. <br>
    <a0 onclick='window.story.show("_back_");'>Pass on</a>
    </div>
</article><article id="LogPanel"></article></section>
<script> function rollGrope(){
    if(window.story.state.tmp.args[1]) return;
    let _rnd=_.random(1,100);
    if(_rnd<40){
        window.gm.printTalkLink("div#select1","div#choice1a")
    } else {
        window.gm.printTalkLink("div#select1","div#choice1b")
    }
    window.gm.addTime(60);
    window.story.state.tmp.args=[null,1];
}
function react(){
    let _rnd=_.random(1,100);
}
rollGrope();
</script>


